# Copy to .env. SOUND_MUTED=true mutes every sound (tests, headless QA).
SOUND_MUTED=

# Asset generation (scripts/pl-*.ts, scripts/el-*.ts). Never commit real keys.
ELEVENLABS_API_KEY=
PIXELLAB_API_TOKEN=

# Build flavours (usually set by the build command, not here): 1 = on.
VITE_DEMO=
VITE_POKI=

---
import type { Lang } from '@/i18n';
import { BASE, url } from '@/links';

interface Props {
	lang: Lang;
	label: string;
}

const { lang, label } = Astro.props;
const NAMES: Record<Lang, string> = { en: 'English', 'pt-BR': 'Português' };
const href: Record<Lang, string> = { en: url(''), 'pt-BR': url('pt/') };
---

<!-- Native <details>: works without JS. The script below points each link at the same page in the other language. -->
<details class="relative">
	<!-- The accessible name starts with the visible text (EN/English), so a voice user hears what they see. -->
	<summary class="btn cursor-pointer list-none py-1 text-base whitespace-nowrap">
		<span class="sr-only">{label}: </span>
		<span class="sm:hidden">{lang === 'en' ? 'EN' : 'PT'}</span>
		<span class="hidden sm:inline">{NAMES[lang]}</span>
		<span aria-hidden="true">▾</span>
	</summary>
	<ul
		class="absolute right-0 mt-1 min-w-36 list-none overflow-hidden rounded-panel border-2 border-panel-dark bg-panel p-0 shadow-solid"
	>
		{
			(Object.keys(NAMES) as Lang[]).map((l) => (
				<li>
					<a
						href={href[l]}
						hreflang={l}
						data-lang-root={l}
						aria-current={l === lang ? 'true' : undefined}
						class:list={[
							'flex min-h-11 items-center px-3 no-underline hover:bg-panel-dark',
							l === lang ? 'text-gold' : 'text-text',
						]}
					>
						{NAMES[l]}
					</a>
				</li>
			))
		}
	</ul>
	<script is:inline define:vars={{ base: BASE }}>
		(() => {
			const rest = location.pathname.startsWith(base)
				? location.pathname.slice(base.length)
				: '';
			const page = rest.replace(/^pt(\/|$)/, '');
			for (const a of document.querySelectorAll('a[data-lang-root]'))
				a.href = base + (a.dataset.langRoot === 'en' ? '' : 'pt/') + page;
		})();
	</script>
</details>

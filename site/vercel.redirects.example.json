{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "www.zapatro.com" }],
			"destination": "https://zapatro.com/:path*",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "truco.lekzera.xyz" }],
			"destination": "https://zapatro.com/:path*",
			"permanent": true
		},
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "zapaco.vercel.app" }],
			"destination": "https://zapatro.com/:path*",
			"permanent": true
		}
	]
}

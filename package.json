{
	"name": "zapatro.com",
	"private": true,
	"version": "0.13.1",
	"buildName": "flat",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "bun check --no-script && bunx --bun vite build",
		"build:demo": "VITE_DEMO=1 bun run build",
		"build:poki": "VITE_DEMO=1 VITE_POKI=1 bun run build",
		"preview": "bunx --bun vite preview",
		"electron:install": "bun install --cwd desktop",
		"electron:dev": "bun run build && bun run --cwd desktop start",
		"electron:smoke": "bun run --cwd desktop smoke",
		"electron:build": "bun scripts/build-electron.ts",
		"exe": "bun scripts/build-electron.ts --exe",
		"android:install": "bun install --cwd mobile",
		"android:sync": "bun scripts/build-android.ts --sync-only",
		"android:open": "bun run --cwd mobile open",
		"android:run": "bun scripts/build-android.ts --sync-only && bun run --cwd mobile run",
		"android:apk": "bun scripts/build-android.ts --apk",
		"android:debug": "bun scripts/build-android.ts --debug",
		"android:bundle": "bun scripts/build-android.ts",
		"app-icons": "bun scripts/app-icons.ts",
		"release": "bun scripts/release.ts",
		"lan-server": "bun lan/cli.ts",
		"site:build": "bun scripts/site-build.ts",
		"site:deploy": "cd site && bunx vercel@62.1.0 deploy --prod --yes",
		"balance": "bun scripts/balance.ts --seeds 3",
		"graph": "uvx --from graphifyy==0.9.71 graphify update . || graphify update .",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "bun check --no-script",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"prepare": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@colyseus/core": "0.18.23",
		"@colyseus/sdk": "^0.18.8",
		"@colyseus/ws-transport": "0.18.4",
		"@fontsource/rubik": "5.3.0",
		"phaser": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "^1.4.2",
		"markdownlint-cli2": "0.23.3",
		"playwright": "1.63.0",
		"sharp": "0.34",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	}
}
